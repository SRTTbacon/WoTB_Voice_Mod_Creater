<UserControl x:Class="WoTB_Voice_Mod_Creater.Class.AutoSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WoTB_Voice_Mod_Creater.Class"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanBrush" Color="Gray"/>
        <SolidColorBrush x:Key="PinkBrush" Color="Gray"/>
        <SolidColorBrush x:Key="LimeBrush" Color="Gray"/>
        <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}, Mode=FindAncestor}}" Width="25" Height="25"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomSliderStyle" TargetType="{x:Type Slider}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TickBar Grid.Row="0" x:Name="TopTick" Placement="Top" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Height="8" Opacity="0.64" Margin="0,0,0,2"/>
                                    <TickBar Grid.Row="2" x:Name="BottomTick" Placement="Bottom" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Height="8" Opacity="0.64" Margin="0,2,0,0"/>
                                    <Track Grid.Row="1" x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Background="Yellow" Height="5" BorderBrush="{x:Null}" Opacity="1"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Background="Gray" Height="5" BorderBrush="{x:Null}" Opacity="0.5"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Slider.TickPlacement" Value="TopLeft">
                                        <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="Slider.TickPlacement" Value="BottomRight">
                                        <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="Slider.TickPlacement" Value="Both">
                                        <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Button_MouseOver_Style" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#669625B1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Viewbox>
        <DockPanel Width="1920" Height="1080">
            <Border BorderBrush="Black" BorderThickness="1" Background="#1F2A2F" Height="1080" VerticalAlignment="Top" Width="1920"/>
            <Button x:Name="Exit_B" Content="戻る" Height="75" VerticalAlignment="Top" Width="325" Foreground="Aqua" FontSize="40" Style="{StaticResource Button_MouseOver_Style}" BorderBrush="Aqua" Margin="-3513,1004,0,0" Focusable="False" Click="Exit_B_Click"/>
            <ListBox x:Name="Event_List" Height="750" VerticalAlignment="Top" Width="600" Background="Transparent" FontSize="35" Foreground="Aqua" BorderBrush="Aqua" Margin="-3100,175,0,0" Focusable="False" SelectionChanged="Event_List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:TextListItem">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="0,0,0,1" BorderBrush="Aqua"/>
                            <TextBlock FontSize="30" Foreground="{Binding TextColor}" Text="{Binding EventName}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Height="55" Width="300" TextWrapping="Wrap" Text="音声イベントリスト" Foreground="Aqua" FontSize="40" Margin="-3125,100,0,0" VerticalAlignment="Top" TextAlignment="Center"/>
            <ListBox x:Name="Item_List" Height="350" VerticalAlignment="Top" Width="700" Background="Transparent" FontSize="35" Foreground="Aqua" BorderBrush="Aqua" Margin="-1100,175,0,0" Focusable="False">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:TextListItem">
                        <Grid Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button DataContext="{Binding ButtonName}" Grid.Column="0" Foreground="Aqua" BorderBrush="Aqua" Content="🖊" Height="35" FontSize="20" Style="{StaticResource Button_MouseOver_Style}" Click="Rename_B_Click"/>
                            <Border Grid.Column="1" Margin="10,0,0,0" BorderThickness="0,0,0,1" BorderBrush="Aqua"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="32" Foreground="Aqua" Text="{Binding ItemName}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Height="55" Width="300" TextWrapping="Wrap" Text="検索キーワード" Foreground="Aqua" FontSize="40" Margin="-1125,100,0,0" VerticalAlignment="Top" TextAlignment="Center"/>
            <Button x:Name="Search_Help_B" Content="?" Height="50" VerticalAlignment="Top" Width="50" Foreground="Aqua" FontSize="35" Style="{StaticResource Button_MouseOver_Style}" BorderBrush="Aqua" Margin="-825,103,0,0" Focusable="False" Click="Search_Help_B_Click"/>
            <Button x:Name="Add_B" Content="追加" Height="75" VerticalAlignment="Top" Width="325" Foreground="Aqua" FontSize="40" Style="{StaticResource Button_MouseOver_Style}" BorderBrush="Aqua" Margin="-1475,525,0,0" Focusable="False" Click="Add_B_Click"/>
            <Button x:Name="Remove_B" Content="削除" Height="75" VerticalAlignment="Top" Width="325" Foreground="Aqua" FontSize="40" Style="{StaticResource Button_MouseOver_Style}" BorderBrush="Aqua" Margin="-725,525,0,0" Focusable="False" Click="Remove_B_Click"/>
            <Image x:Name="FolderMode_C" Height="30" VerticalAlignment="Top" Width="30" Margin="-1775,780,0,0" MouseDown="FolderMode_C_MouseDown" MouseEnter="FolderMode_C_MouseEnter" MouseLeave="FolderMode_C_MouseLeave" Focusable="False"/>
            <TextBlock Height="45" Width="300" TextWrapping="Wrap" Text="ーーー全体設定ーーー" Foreground="Aqua" FontSize="35" Margin="-1450,700,0,0" VerticalAlignment="Top" TextAlignment="Left"/>
            <TextBlock Height="45" Width="300" TextWrapping="Wrap" Text="フォルダ名として検索" Foreground="Aqua" FontSize="35" Margin="-1425,770,0,0" VerticalAlignment="Top" TextAlignment="Left"/>
            <Image x:Name="IncludeSubFolder_C" Height="30" VerticalAlignment="Top" Width="30" Margin="-1775,855,0,0" MouseDown="IncludeSubFolder_C_MouseDown" MouseEnter="IncludeSubFolder_C_MouseEnter" MouseLeave="IncludeSubFolder_C_MouseLeave" Focusable="False"/>
            <TextBlock Height="45" Width="350" TextWrapping="Wrap" Text="サブフォルダを含めて検索" Foreground="Aqua" FontSize="35" Margin="-1380,845,0,0" VerticalAlignment="Top" TextAlignment="Left"/>
            <Border BorderBrush="{x:Null}" Width="850" Height="140" Margin="-1920,928,0,0">
                <TextBlock x:Name="Message_T" Text="" Foreground="Aqua" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Canvas x:Name="Rename_Canvas" Visibility="Hidden">
                <Border Width="1920" Height="1080" Background="Black" Opacity="0.75" Margin="-1920,0,0,0"/>
                <TextBlock FontSize="37" Height="45" Width="225" TextWrapping="Wrap" Text="Mod名を変更" VerticalAlignment="Top" Margin="-1920,450,0,0" Foreground="Aqua" TextAlignment="Center"/>
                <TextBox x:Name="Rename_T" Width="750" Height="50" FontSize="33" Margin="-1920, 540,0,0" Text="" TextAlignment="Center"/>
                <Button x:Name="Rename_Cancel_B" Content="キャンセル" Height="60" VerticalAlignment="Top" Width="250" Style="{StaticResource Button_MouseOver_Style}" Focusable="False" Foreground="Aqua" BorderBrush="Aqua" FontSize="35" Margin="-2250,650,0,0" Click="Rename_Cancel_B_Click"/>
                <Button x:Name="Rename_Apply_B" Content="変更" Height="60" VerticalAlignment="Top" Width="250" Style="{StaticResource Button_MouseOver_Style}" Focusable="False" Foreground="Aqua" BorderBrush="Aqua" FontSize="35" Margin="-1600,650,0,0" Click="Rename_Apply_B_Click"/>
            </Canvas>
        </DockPanel>
    </Viewbox>
</UserControl>
